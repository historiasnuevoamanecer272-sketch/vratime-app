{
  "name": "vratime-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:quality",
    "test:quality": "npm run lint && npm run test:i18n && npm run test:search && npm run test:contacts && npm run test:webhook && npm run test:migrations && npm run build && npm run test:static",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "node scripts/supabase-migrate.mjs",
    "db:snapshot": "node scripts/supabase-snapshot.mjs",
    "db:check": "node scripts/supabase-migrate.mjs --check",
    "db:public": "node scripts/supabase-public-check.mjs",
    "db:test": "node scripts/supabase-integration-check.mjs",
    "db:e2e": "node scripts/supabase-e2e-check.mjs",
    "test:i18n": "node scripts/i18n-check.mjs",
    "test:static": "node scripts/static-check.mjs",
    "test:search": "node scripts/category-search-check.mjs",
    "test:contacts": "node scripts/contacts-check.mjs",
    "test:webhook": "node --experimental-strip-types scripts/tribute-webhook-check.mjs",
    "test:migrations": "node scripts/migration-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "i18next": "^26.4.0",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.12",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pg": "^8.23.0",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0"
  }
