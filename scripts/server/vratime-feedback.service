[Unit]
Description=VratiMe pending support delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/lock/vratime-feedback.lock /usr/bin/python3 /root/vratime-release-20261019/vratime-workers.py feedback
TimeoutStartSec=70
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/lock
